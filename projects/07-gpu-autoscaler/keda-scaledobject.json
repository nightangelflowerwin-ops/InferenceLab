{
  "apiVersion": "keda.sh/v1alpha1",
  "kind": "ScaledObject",
  "metadata": {"name": "inference-token-queue", "namespace": "inference-lab"},
  "spec": {
    "scaleTargetRef": {"name": "inference-worker"},
    "pollingInterval": 5,
    "cooldownPeriod": 30,
    "minReplicaCount": 0,
    "maxReplicaCount": 8,
    "advanced": {
      "horizontalPodAutoscalerConfig": {
        "behavior": {"scaleDown": {"stabilizationWindowSeconds": 30}}
      }
    },
    "triggers": [{
      "type": "prometheus",
      "metadata": {
        "serverAddress": "http://prometheus.monitoring.svc:9090",
        "query": "sum(inference_queue_pending_tokens) + sum(inference_queue_leased_tokens)",
        "threshold": "2048",
        "activationThreshold": "0",
        "ignoreNullValues": "false"
      }
    }]
  }
}
