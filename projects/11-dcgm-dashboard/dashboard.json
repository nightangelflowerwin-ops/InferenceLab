{
  "uid": "inferencelab-gpu",
  "title": "InferenceLab GPU telemetry (synthetic fixture by default)",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "inference",
    "gpu",
    "fixture-default"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GPU temperature",
      "description": "Configured threshold is a warning, not a vendor-specific thermal diagnosis.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inferencelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_TEMP",
          "legendFormat": "{{gpu}} {{source}} {{clock_event}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "SM active ratio",
      "description": "SM activity is distinct from occupancy. Profiling fields may be unavailable.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inferencelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_PROF_SM_ACTIVE",
          "legendFormat": "{{gpu}} {{source}} {{clock_event}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "SM occupancy ratio",
      "description": "Resident-warps fraction; unavailable fields must remain No data.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inferencelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_PROF_SM_OCCUPANCY",
          "legendFormat": "{{gpu}} {{source}} {{clock_event}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Framebuffer used fraction",
      "description": "Frame-buffer capacity fraction, not a measurement of model allocation alone.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inferencelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_FB_USED / (DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE)",
          "legendFormat": "{{gpu}} {{source}} {{clock_event}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Software CUDA OOM counter",
      "description": "Custom serving-software counter. DCGM does not directly provide this application OOM count. Fixture source is explicit.",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inferencelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_gpu_oom_total",
          "legendFormat": "{{gpu}} {{source}} {{clock_event}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "PCIe TX bandwidth",
      "description": "DCGM Exporter profiling gauge in bytes per second; verify deployed exporter support.",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inferencelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_PROF_PCIE_TX_BYTES",
          "legendFormat": "{{gpu}} {{source}} {{clock_event}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PCIe RX bandwidth",
      "description": "DCGM Exporter profiling gauge in bytes per second; verify deployed exporter support.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inferencelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_PROF_PCIE_RX_BYTES",
          "legendFormat": "{{gpu}} {{source}} {{clock_event}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Clock-event window sample count",
      "description": "Counts samples with active clock-event bits, not unique incidents. Requires exporter clock-event support.",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inferencelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_EXP_CLOCK_EVENTS_COUNT{clock_event!=\"\"}",
          "legendFormat": "{{gpu}} {{source}} {{clock_event}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Fixture-data indicator",
      "description": "Value 1 indicates synthetic demo telemetry. No GPU measurement was made.",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inferencelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_lab_fixture",
          "legendFormat": "{{gpu}} {{source}} {{clock_event}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "editable": true
}